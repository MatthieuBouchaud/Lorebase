# Optional bootstrap overrides
BRAIN_REPO=$HOME/Brain
GBRAIN_REPO=$HOME/gbrain
TIMEZONE=
OPERATOR_DISPLAY_NAME=
CODEX_MODEL=gpt-5.4

# GBrain runtime keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Source-to-brain embedding behavior
# stale = publish text, then run `gbrain embed --stale`
# off = publish text only
SOURCE_TO_BRAIN_EMBED_MODE=stale
SOURCE_TO_BRAIN_REQUIRE_EMBEDDINGS=0
GBRAIN_EMBED_CONCURRENCY=4

# Telegram-to-brain only
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
