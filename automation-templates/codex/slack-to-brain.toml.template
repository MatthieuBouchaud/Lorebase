version = 1
id = "slack-to-brain"
kind = "cron"
name = "Slack to Brain"
prompt = "Use [$source-to-brain-automation]({{CODEX_SKILL_PATH}}) with recipe {{GBRAIN_REPO}}/recipes/slack-to-brain.md. The writable brain repo is {{BRAIN_REPO}} and source-state files stay under {{GBRAIN_REPO}}. Start with DMs, mentions, and explicitly configured high-signal channels. Open an inbox item with the result of the run."
status = "PAUSED"
rrule = "RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR,SA,SU;BYHOUR=9;BYMINUTE=10"
model = "{{MODEL}}"
reasoning_effort = "high"
execution_environment = "local"
cwds = ["{{GBRAIN_REPO}}", "{{BRAIN_REPO}}"]
