version = 1
id = "telegram-to-brain"
kind = "cron"
name = "Telegram to Brain"
prompt = "Use [$source-to-brain-automation]({{CODEX_SKILL_PATH}}) with recipe {{GBRAIN_REPO}}/recipes/telegram-to-brain.md. Run the Telethon user-session workflow, not a bot workflow. Capture account-visible DMs, groups, supergroups, and channels into Telegram sync outputs, then file high-signal items into {{BRAIN_REPO}} using the source-to-brain publish flow. Source-state files stay under {{GBRAIN_REPO}}. Open an inbox item with the result of the run, including any missing Telethon credentials or session blockers."
status = "PAUSED"
rrule = "RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR,SA,SU;BYHOUR=9;BYMINUTE=20"
model = "{{MODEL}}"
reasoning_effort = "high"
execution_environment = "local"
cwds = ["{{GBRAIN_REPO}}", "{{BRAIN_REPO}}"]
